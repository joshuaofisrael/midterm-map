# Read by Netlify and Cloudflare Pages. GitHub Pages ignores this file.
# Cloudflare in front of GitHub Pages uses the cache rules in
# docs/election-night-scale-plan.md instead.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/visuals/*
  Cache-Control: public, max-age=2592000

/og/*
  Cache-Control: public, max-age=2592000

/candidates/*
  Cache-Control: public, max-age=2592000

/live/results.json
  Cache-Control: public, max-age=60
  X-Content-Type-Options: nosniff

/*.html
  Cache-Control: public, max-age=600
